{
  "name": "hyron",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hyron-history",
      "database_id": "fd1cd349-a6ad-4ce6-9db0-19c9923f8975"
    }
  ]
}